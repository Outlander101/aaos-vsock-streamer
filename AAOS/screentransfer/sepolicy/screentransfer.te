type screentransfer, domain, coredomain;
type screentransfer_exec, system_file_type, exec_type, file_type;

init_daemon_domain(screentransfer)

# Allow creating and managing vsock sockets for streaming
allow screentransfer self:vsock_socket {
    create          
    bind
    listen
    accept
    connect
    read
    write
    getattr
    getopt
    setopt
    shutdown
};

# Allow searching /dev directory to locate device nodes
allow screentransfer device:dir { search };

# Grant network capabilities for vsock socket operations
allow screentransfer self:capability { net_raw net_admin };

# Allow unix domain sockets for binder and logging
allow screentransfer self:unix_stream_socket { create connect read write };

# Enable binder IPC mechanism
binder_use(screentransfer)

# Allow calling system services via binder
binder_call(screentransfer, servicemanager)
binder_call(screentransfer, surfaceflinger)
binder_call(screentransfer, system_server)
binder_call(screentransfer, mediaserver)

# Allow receiving binder callbacks from services
binder_call(mediaserver, screentransfer)
binder_call(surfaceflinger, screentransfer)

# Allow finding and binding to system services
allow screentransfer surfaceflinger_service:service_manager find;
allow screentransfer mediaserver_service:service_manager find;
allow screentransfer package_native_service:service_manager find;

# Graphics Allocator HAL
hal_client_domain(screentransfer, hal_graphics_allocator)

# Codec2 HAL
hal_client_domain(screentransfer, hal_codec2)

# GPU device directory (/dev/dri/)
allow screentransfer gpu_device:dir { search read open getattr };

# GPU device nodes (/dev/dri/card*, /dev/dri/renderD*)
allow screentransfer gpu_device:chr_file { read write open ioctl getattr map };

# Graphics device directory (/dev/graphics/)
allow screentransfer graphics_device:dir { search read open getattr };

# Graphics device nodes - for graphics operations
allow screentransfer graphics_device:chr_file { read write open ioctl getattr map };

# Video device directory (/dev/video*)
allow screentransfer video_device:dir { search };

# Video device nodes
allow screentransfer video_device:chr_file { read write open ioctl getattr };

# ION allocator
allow screentransfer ion_device:chr_file { read write open ioctl getattr };

# DMA-BUF system heap
allow screentransfer dmabuf_system_heap_device:chr_file {
    getattr         
    open
    read
    write
    ioctl
    map
};

# System files directory
allow screentransfer system_file:dir { search read open getattr };
allow screentransfer system_file:file { read open getattr execute map };

# System libraries directory
allow screentransfer system_lib_file:dir  { search read open getattr };
allow screentransfer system_lib_file:file { read open getattr execute map };

# Tmpfs directory
allow screentransfer tmpfs:dir  { search read open getattr };
allow screentransfer tmpfs:file { read write open getattr map };

# Self process signal handling
allow screentransfer self:process { signal sigchld sigkill sigstop };
allow screentransfer self:process { setsched setpgid };

# Allow connecting to logd for Android logging (logcat)
allow screentransfer logd:unix_stream_socket { connectto };

# Sysfs directory
allow screentransfer sysfs:dir { search read open getattr };