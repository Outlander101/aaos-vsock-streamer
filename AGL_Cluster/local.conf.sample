# Example local.conf additions for AGL Cluster VSOCK RTSP bridge

# --- Multimedia for cluster-dashboard (QML: import QtMultimedia) ---
IMAGE_INSTALL:append = " \
  qtmultimedia \
  qtmultimedia-qmlplugins \
  gstreamer1.0 \
  gstreamer1.0-plugins-base \
  gstreamer1.0-plugins-good \
  gstreamer1.0-libav \ 
  gstreamer1.0-plugins-bad \
  gstreamer1.0-rtsp-server \
"

IMAGE_INSTALL:append = " vsock-rtsp-fram-bridge "
LICENSE_FLAGS_ACCEPTED:append = " commercial"
